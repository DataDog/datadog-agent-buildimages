@@ -3166,6 +3166,34 @@
 
   *relocation = val + addend;
 
+  /* On XCOFF64, text is loaded at 0x100000000+, so an absolute branch
+     (ba/bla, R_RBA) can never reach it: the 26-bit absolute target field
+     cannot hold such an address and the relocation overflows.  When the
+     target is out of the absolute 26-bit range but is reachable with a
+     pc-relative branch (e.g. an imported symbol resolved via a nearby
+     glink stub), rewrite the instruction to a relative branch by clearing
+     the AA bit (ba->b, bla->bl) and emit a pc-relative displacement.  */
+  if (bfd_xcoff_is_xcoff64 (input_bfd))
+    {
+      bfd_vma target = val + addend;
+      bfd_vma location = (input_section->output_section->vma
+			  + input_section->output_offset
+			  + rel->r_vaddr - input_section->vma);
+      bfd_signed_vma rel_off = (bfd_signed_vma) (target - location);
+
+      if (target + 0x2000000 >= 0x4000000
+	  && rel_off >= -(bfd_signed_vma) 0x2000000
+	  && rel_off < (bfd_signed_vma) 0x2000000)
+	{
+	  bfd_vma off = rel->r_vaddr - input_section->vma;
+	  unsigned long insn = bfd_get_32 (input_bfd, contents + off);
+
+	  insn &= ~(unsigned long) 2;	/* clear AA: absolute -> relative */
+	  bfd_put_32 (input_bfd, insn, contents + off);
+	  *relocation = (bfd_vma) rel_off;
+	}
+    }
+
   return true;
 }
 
