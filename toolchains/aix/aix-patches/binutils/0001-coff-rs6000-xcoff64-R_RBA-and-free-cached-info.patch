+/* Free cached info for an XCOFF bfd.  This behaves like the generic COFF
+   routine (freeing the symbol tables), but preserves the tdata pointer.
+
+   When writing an archive that contains a shared (DYNAMIC) object member,
+   _bfd_compute_and_write_armap slurps each member's symbols and then calls
+   bfd_free_cached_info before the target write_armap routine runs.  The
+   generic _bfd_free_cached_info nulls abfd->tdata.any, but
+   xcoff_write_armap_big -> member_layout_init still dereferences
+   xcoff_data (member)->text_align_power to lay out DYNAMIC members, and it
+   must produce the SAME offsets the contents pass already wrote.  The tdata
+   memory lives on the bfd objalloc and is not actually released until
+   bfd_close, so restoring the pointer is safe and keeps both passes
+   consistent.  */
+
+static bool
+_bfd_xcoff_free_cached_info (bfd *abfd)
+{
+  void *saved_tdata = abfd->tdata.any;
+  bool ret = _bfd_coff_free_cached_info (abfd);
+  abfd->tdata.any = saved_tdata;
+  return ret;
+}
+
