-#define _bfd_xcoff_bfd_free_cached_info coff_bfd_free_cached_info
+#define _bfd_xcoff_bfd_free_cached_info _bfd_xcoff_free_cached_info
 #define _bfd_xcoff_new_section_hook coff_new_section_hook
