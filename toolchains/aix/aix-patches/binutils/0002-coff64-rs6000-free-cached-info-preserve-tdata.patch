+/* Free cached info for an XCOFF64 bfd, but preserve the tdata pointer.
+
+   When writing an archive containing a shared (DYNAMIC) object member,
+   _bfd_compute_and_write_armap slurps each member's symbols and then calls
+   bfd_free_cached_info before write_armap runs.  The generic
+   _bfd_free_cached_info nulls abfd->tdata.any, but xcoff_write_armap_big ->
+   member_layout_init still needs xcoff_data (member)->text_align_power to lay
+   out DYNAMIC members, and must produce offsets matching the contents pass.
+   The tdata memory lives on the bfd objalloc until bfd_close, so restoring
+   the pointer is safe and keeps both layout passes consistent.  */
+
+static bool
+_bfd_xcoff64_free_cached_info (bfd *abfd)
+{
+  void *saved_tdata = abfd->tdata.any;
+  bool ret = _bfd_coff_free_cached_info (abfd);
+  abfd->tdata.any = saved_tdata;
+  return ret;
+}
+
